      <SoundRecorderList Ref="4" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>SoundRecorderList</Alias>
        <Columns isList="true" count="2">
          <value>ORIGINAL,FullName,FullName,FullName,System.String,_x0035_a9fcf9ce5964e5e8f94ce9cc45a0bee</value>
          <value>ORIGINAL,Id_sound_recorder,Id_sound_recorder,Id_sound_recorder,System.Int32,_x0039_ae5ff895dd14d168eb0eec143a7f2a1</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>ad0934779bef482b99cc0a9a87155ccb</Key>
        <Name>SoundRecorderList</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT 
	sr.Id_sound_recorder,
	p.First_name + N' ' + p.Last_name AS FullName
	FROM dbo.Tbl_Sound_Recorders AS sr
	LEFT JOIN dbo.Tbl_Personally AS p ON sr.Id_personal = p.Id_personal
	ORDER BY FullName;
</SqlCommand>
      </SoundRecorderList>
